{
  "name": "@nascencestudio/tapestry-fabric",
  "version": "0.1.0",
  "description": "Content types by proxy for Tapestry sites on StudioCMS: display modes (Full, Teaser, …) and a Page list component that shows pages by category, tag and template",
  "license": "MIT",
  "author": "Nascence Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nascencestudio/tapestry-fabric.git"
  },
  "homepage": "https://github.com/nascencestudio/tapestry-fabric#readme",
  "bugs": {
    "url": "https://github.com/nascencestudio/tapestry-fabric/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./PageList.astro": "./dist/runtime/PageList.astro",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nascencestudio/tapestry": "^0.7.0",
    "astro": "^7.0.0",
    "studiocms": "^0.6.0 || ^0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@nascencestudio/tapestry": "0.7.0",
    "@types/node": "22.20.4",
    "astro": "7.4.2",
    "studiocms": "0.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "astro",
    "studiocms",
    "studiocms-plugin",
    "tapestry",
    "content-types",
    "display-modes",
    "views"
  ],
  "packageManager": "pnpm@12.4.2"
}
